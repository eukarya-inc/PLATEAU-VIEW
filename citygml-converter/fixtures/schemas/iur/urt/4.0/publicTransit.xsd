	<!-- ===================================================================== -->
	<!-- =====================　CityGML PublicTransit module ================= -->
	<!-- ===================================================================== -->
	<complexType name="PublicTransitType">
		<complexContent>
			<extension base="core:AbstractThematicSurfaceType">
				<sequence>
					<element name="info" type="urt:PublicTransitTypePropertyType" minOccurs="0" maxOccurs="unbounded"/>
					<element name="data" type="urt:PublicTransitDataTypePropertyType" minOccurs="0" maxOccurs="unbounded"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<element name="PublicTransit" type="urt:PublicTransitType" substitutionGroup="core:AbstractThematicSurface"/>
	<complexType name="PublicTransitPropertyType">
		<sequence minOccurs="0">
			<element ref="urt:PublicTransit"/>
		</sequence>
		<attributeGroup ref="gml:AssociationAttributeGroup"/>
	</complexType>
	<!-- ===================================================================== -->
	<!-- =================     Type Declaration    ======================= -->
	<!-- ===================================================================== -->
	<complexType name="PublicTransitTypeType" abstract="true">
		<complexContent>
			<extension base="gml:AbstractGMLType">
				<sequence>
					<element name="orgId" type="string">
						<annotation>
							<documentation>id field of GTFS files</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<element name="PublicTransitType" type="urt:PublicTransitTypeType" abstract="true" substitutionGroup="gml:AbstractGML"/>
	<complexType name="PublicTransitTypePropertyType">
		<sequence minOccurs="0">
			<element ref="urt:PublicTransitType"/>
		</sequence>
		<attributeGroup ref="gml:AssociationAttributeGroup"/>
	</complexType>
	<!-- ===================================================================== -->
	<complexType name="TargetPropertyType">
		<sequence minOccurs="0">
			<element ref="core:AbstractCityObject"/>
		</sequence>
		<attributeGroup ref="gml:AssociationAttributeGroup"/>
	</complexType>
	<!-- ===================================================================== -->
	<complexType name="RouteType">
		<complexContent>
			<extension base="urt:PublicTransitTypeType">
				<sequence>
					<element name="shortName" type="string" minOccurs="0"/>
					<element name="longName" type="string" minOccurs="0"/>
					<element name="description" type="urt:DescriptionPropertyType" minOccurs="0"/>
					<element name="type" type="gml:CodeType"/>
					<element name="url" type="string" minOccurs="0"/>
					<element name="color" type="string" minOccurs="0"/>
					<element name="textColor" type="string" minOccurs="0"/>
					<element name="updateDate" type="date" minOccurs="0">
						<annotation>
							<documentation>extended field in GTFS-JP</documentation>
						</annotation>
					</element>
					<element name="originStop" type="string" minOccurs="0">
						<annotation>
							<documentation>extended field in GTFS-JP</documentation>
						</annotation>
					</element>
					<element name="viaStop" type="string" minOccurs="0">
						<annotation>
							<documentation>extended field in GTFS-JP</documentation>
						</annotation>
					</element>
					<element name="destinationStop" type="string" minOccurs="0">
						<annotation>
							<documentation>extended field in GTFS-JP</documentation>
						</annotation>
					</element>
					<element name="routeSortOrder" type="integer" minOccurs="0"/>
					<element name="continuousPickup" type="gml:CodeType" minOccurs="0"/>
					<element name="continuousDropOff" type="gml:CodeType" minOccurs="0"/>
					<element name="agency" type="urt:AgencyPropertyType"/>
					<element name="parentRoute" type="urt:RoutePropertyType" minOccurs="0">
						<annotation>
							<documentation>extended field in GTFS-JP</documentation>
						</annotation>
					</element>
					<element name="lod0MultiCurve" type="gml:MultiCurvePropertyType" minOccurs="0">
						<annotation>
							<documentation>geometric property added in this module</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<element name="Route" type="urt:RouteType" substitutionGroup="urt:PublicTransitType"/>
	<complexType name="RoutePropertyType">
		<sequence minOccurs="0">
			<element ref="urt:Route"/>
		</sequence>
		<attributeGroup ref="gml:AssociationAttributeGroup"/>
	</complexType>
	<!-- ===================================================================== -->
	<complexType name="DescriptionType">
		<sequence>
			<element name="description" type="string" minOccurs="0">
				<annotation>
					<documentation>route_desc</documentation>
				</annotation>
			</element>
			<element name="frequencyOfService" type="integer" minOccurs="0">
				<annotation>
					<documentation>extended information defined in this modeule</documentation>
				</annotation>
			</element>
			<element name="numberOfCustomers" type="integer" minOccurs="0">
				<annotation>
					<documentation>extended information defined in this modeule</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<element name="Description" type="urt:DescriptionType"/>
	<complexType name="DescriptionPropertyType">
		<sequence>
			<element ref="urt:Description"/>
		</sequence>
	</complexType>
	<!-- ===================================================================== -->
	<complexType name="AgencyType">

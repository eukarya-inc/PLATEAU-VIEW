				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<element name="CalendarDate" type="urt:CalendarDateType" substitutionGroup="urt:PublicTransitType"/>
	<complexType name="CalendarDatePropertyType">
		<sequence minOccurs="0">
			<element ref="urt:CalendarDate"/>

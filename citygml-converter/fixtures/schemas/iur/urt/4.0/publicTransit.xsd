						<annotation>
							<documentation>extended field in GTFS-JP</documentation>
						</annotation>
					</element>
					<element name="route" type="urt:RoutePropertyType"/>
					<element name="calendar" type="urt:CalendarPropertyType" minOccurs="0"/>
					<element name="calendarDate" type="urt:CalendarDatePropertyType" minOccurs="0"/>
					<element name="office" type="urt:OfficePropertyType" minOccurs="0">
						<annotation>
							<documentation>extended field in GTFS-JP</documentation>
						</annotation>
					</element>
					<element name="shape" type="urt:ShapePropertyType" minOccurs="0"/>
					<element name="lod0MultiCurve" type="gml:MultiCurvePropertyType" minOccurs="0">
						<annotation>
							<documentation>extended property defined in this module. The curve is composed of a sequence of points in a shape.</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<element name="Trip" type="urt:TripType" substitutionGroup="urt:PublicTransitType"/>
	<complexType name="TripPropertyType">
		<sequence minOccurs="0">

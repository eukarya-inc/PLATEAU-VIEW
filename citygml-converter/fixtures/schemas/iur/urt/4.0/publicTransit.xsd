<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:core="http://www.opengis.net/citygml/3.0" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:urt="https://www.geospatial.jp/iur/urt/4.0" targetNamespace="https://www.geospatial.jp/iur/urt/4.0" elementFormDefault="qualified" version="4.0.0" xmlns:urc="https://www.geospatial.jp/iur/urc/4.0">

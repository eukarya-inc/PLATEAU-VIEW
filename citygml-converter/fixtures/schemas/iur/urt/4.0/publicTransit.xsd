		<attributeGroup ref="gml:AssociationAttributeGroup"/>
	</complexType>
	<!-- ===================================================================== -->
	<element name="Shape" type="urt:ShapeType" substitutionGroup="urt:PublicTransitType"/>
	<complexType name="ShapeType">
		<complexContent>
			<extension base="urt:PublicTransitTypeType">
				<sequence>
					<element name="point" type="urt:PointPropertyType" minOccurs="0" maxOccurs="unbounded"/>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<complexType name="ShapePropertyType">
		<sequence minOccurs="0">
			<element ref="urt:Shape"/>
		</sequence>
		<attributeGroup ref="gml:AssociationAttributeGroup"/>
	</complexType>
	<!-- ===================================================================== -->
	<complexType name="PointType">
		<sequence>
			<element name="latitude" type="double"/>
			<element name="longitude" type="double"/>
			<element name="point" type="gml:PointPropertyType"/>
			<element name="pointSequence" type="nonNegativeInteger"/>
			<element name="pointDistanceTraveled" type="double" minOccurs="0"/>
		</sequence>
	</complexType>
	<element name="Point" type="urt:PointType"/>
	<complexType name="PointPropertyType">
		<sequence>
			<element ref="urt:Point"/>
		</sequence>
	</complexType>
	<!-- ===================================================================== -->
	<complexType name="OfficeType">
		<annotation>
			<documentation>extended file in GTFS-JP</documentation>

			</extension>
		</complexContent>
	</complexType>
	<element name="Level" type="urt:LevelType" substitutionGroup="urt:PublicTransitType"/>
	<complexType name="LevelPropertyType">
		<sequence minOccurs="0">
			<element ref="urt:Level"/>
		</sequence>
		<attributeGroup ref="gml:AssociationAttributeGroup"/>
	</complexType>

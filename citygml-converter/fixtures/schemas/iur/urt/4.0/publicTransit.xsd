					<element name="phone" type="string" minOccurs="0"/>
					<element name="fareUrl" type="anyURI" minOccurs="0"/>
					<element name="email" type="string" minOccurs="0"/>
					<element name="officialName" type="string" minOccurs="0">
						<annotation>
							<documentation>extended field in GTFS-JP</documentation>
						</annotation>
					</element>
					<element name="zipNumber" type="string" minOccurs="0">
						<annotation>
							<documentation>extended field in GTFS-JP</documentation>
						</annotation>
					</element>
					<element name="address" type="string" minOccurs="0">
						<annotation>
							<documentation>extended field in GTFS-JP</documentation>
						</annotation>
					</element>
					<element name="presidentPosition" type="string" minOccurs="0">
						<annotation>
							<documentation>extended field in GTFS-JP</documentation>
						</annotation>
					</element>
					<element name="presidentName" type="string" minOccurs="0">
						<annotation>
							<documentation>extended field in GTFS-JP</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>
	<element name="Agency" type="urt:AgencyType" substitutionGroup="urt:PublicTransitType"/>
	<complexType name="AgencyPropertyType">
		<sequence minOccurs="0">
			<element ref="urt:Agency"/>
		</sequence>
		<attributeGroup ref="gml:AssociationAttributeGroup"/>
	</complexType>
	<!-- ===================================================================== -->
	<complexType name="StopType">

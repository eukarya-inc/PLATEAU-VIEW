---
import { LinkButton } from "@astrojs/starlight/components";
import { GITHUB_URL, PLATEAU_VIEW_URL } from "../site.js";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-inner sl-flex stack">
    <div class="sl-flex copy">
      <h1 id="_top" data-page-title set:html={title} />
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    <div class="sl-flex actions">
      {
        actions.map(({ icon, link, text, variant, attrs }) => (
          <LinkButton
            href={link}
            variant={variant}
            icon={icon?.name}
            iconPlacement="end"
            {...attrs}
          >
            {text}
          </LinkButton>
        ))
      }
      <LinkButton
        href={PLATEAU_VIEW_URL}
        variant="secondary"
        icon="external"
        iconPlacement="end"
      >
        PLATEAU VIEW を見る
      </LinkButton>
      <LinkButton
        href={GITHUB_URL}
        variant="secondary"
        icon="external"
        iconPlacement="end"
      >
        GitHub
      </LinkButton>
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-inline: calc(50% - 50vw);
    margin-top: calc(-1 * var(--sl-content-pad-y, 1.5rem));
    padding-inline: max(1.5rem, calc(50vw - 50%));
    padding-block: clamp(3rem, calc(2rem + 10vmin), 9rem);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: clamp(20rem, 55vh, 34rem);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.75) 0%,
        rgba(0, 0, 0, 0.55) 35%,
        rgba(0, 0, 0, 0.25) 70%,
        rgba(0, 0, 0, 0.1) 100%
      ),
      url("/image.webp");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  :global([data-theme="light"]) .hero-bg {
    background-image:
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.85) 0%,
        rgba(255, 255, 255, 0.65) 35%,
        rgba(255, 255, 255, 0.35) 70%,
        rgba(255, 255, 255, 0.15) 100%
      ),
      url("/image.webp");
  }
  .hero-inner {
    width: 100%;
    max-width: 60rem;
  }
  .stack {
    flex-direction: column;
    gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
    text-align: start;
  }
  .copy {
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .copy > * {
    max-width: 50ch;
  }
  h1 {
    font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .tagline {
    font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
    color: var(--sl-color-gray-2);
  }
  .actions {
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    justify-content: flex-start;
  }
</style>

---
import config from "virtual:starlight/user-config";

import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";

const navLinks = [
  { label: "データセット一覧", href: "/datasets/explorer/" },
  { label: "CityGML", href: "/datasets/citygml/" },
  { label: "3D Tiles / MVT", href: "/datasets/3d-tiles/" },
  { label: "Terrain", href: "/datasets/terrain/" },
  { label: "Ortho", href: "/datasets/ortho/" },
  { label: "API", href: "/api/" },
];

const currentPath = "/" + (Astro.url.pathname.replace(/^\/+|\/+$/g, "") || "");
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <nav class="top-nav print:hidden" aria-label="サイトナビゲーション">
    <ul>
      {
        navLinks.map(({ label, href }) => {
          const isActive =
            currentPath === href.replace(/\/$/, "") ||
            (href !== "/" && currentPath.startsWith(href.replace(/\/$/, "")));
          return (
            <li>
              <a href={href} aria-current={isActive ? "page" : undefined}>
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
  <div class="sl-flex print:hidden search-wrapper">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }
  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }
  .top-nav {
    display: none;
  }
  .top-nav ul {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .top-nav a {
    display: inline-block;
    padding: 0.4rem 0.7rem;
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 0.375rem;
    white-space: nowrap;
    transition: background 0.12s, color 0.12s;
  }
  .top-nav a:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .top-nav a[aria-current="page"] {
    background: var(--sl-color-accent-low, var(--sl-color-gray-6));
    color: var(--sl-color-accent-high, var(--sl-color-white));
  }
  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .social-icons::after {
    content: "";
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  @media (min-width: 50rem) {
    :global(:root[data-has-sidebar]) {
      --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
    }
    :global(:root:not([data-has-toc])) {
      --__toc-width: 0rem;
    }
    .header {
      display: grid;
      grid-template-columns: auto auto 1fr auto;
      align-items: center;
    }
    .top-nav {
      display: block;
    }
  }

  @media (max-width: 80rem) {
    .top-nav a {
      padding: 0.4rem 0.5rem;
      font-size: 0.8rem;
    }
  }
</style>
